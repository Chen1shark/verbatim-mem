#!/bin/sh
# Strip Co-authored-by and Cursor attribution trailers.
msgfile="$1"
tmp="${msgfile}.nocoauthor"
awk '
BEGIN { IGNORECASE = 1 }
/^[[:space:]]*Co-authored-by:/ { next }
/^[[:space:]]*Made-with:/ { next }
/^[[:space:]]*Made-By:/ { next }
/^[[:space:]]*Generated-By:/ { next }
/^[[:space:]]*Made with Cursor/ { next }
{ print }
' "$msgfile" > "$tmp" && mv "$tmp" "$msgfile"
exit 0
