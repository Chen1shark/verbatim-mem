MEMORY_API_KEY=changeme
MEMORY_DB_PATH=data/memory.db

# 付费句向量（阿里云百炼 OpenAI 兼容 /embeddings）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=2560

MEMORY_RETRIEVAL_MODE=hybrid

# 召回池（与 final top_k 分离）
MEMORY_CANDIDATE_POOL=500
MEMORY_FTS_POOL=300
MEMORY_DENSE_POOL=300
MEMORY_BLOCK_POOL=200
MEMORY_SEED_K=25
MEMORY_NEIGHBOR_WINDOW=1
MEMORY_NEIGHBOR_BUDGET=40

# ranking 默认值，供消融覆盖
MEMORY_RRF_K=60
MEMORY_RRF_W_FTS=1.2
MEMORY_RRF_W_DENSE=1.0
MEMORY_RRF_W_BLOCKS=1.1
MEMORY_LEXICAL_WEIGHT=0.25
MEMORY_NUMERIC_WEIGHT=0.20
MEMORY_ENTITY_WEIGHT=0.22
MEMORY_OPTION_WEIGHT=0.18
MEMORY_TIME_WEIGHT_TEMPORAL=0.08
